# copiar este archivo y llenarlo con tus datos, revisar los indicados a no cambiarlos

# ================================
# PostgreSQL
# ================================
# Usuario administrador de la base de datos
POSTGRES_USER=example_admin
# contraseña del usuario administrador (usar una contraseña fuerte)
POSTGRES_PASSWORD=example12345ejemplo
#nombre de la base de datos del proyecto
POSTGRES_DB=example_database
# cambiar este puerto si el 5432 ya lo tienes en uso con otro poroyecto
POSTGRES_HOST_PORT=5432
#puerto interno del contenedor (no cambiar)
POSTGRES_CONTAINER_PORT=5432

# ================================
# Python ETL (red interna de Docker)
# ================================
# Host que usará Python para conectar a Postgres en docker
POSTGRES_HOST=postgres
# Puerto de Postgres dbentro de la red Docker indicado en seccion PostgreSQL
POSTGRES_PORT=5432

# ================================
# pgAdmin
# ================================
# Email de login a pgAdmin
PGADMIN_DEFAULT_EMAIL=example12345@outlook.com
# Usar contraseña fuerte
PGADMIN_DEFAULT_PASSWORD=example92as
# Puerto en tu host 5050 por defecto
PGADMIN_HOST_PORT=5050

# ================================
# Superset
# ================================
# Gernerarla en terminal con openssl rand -base64 42
SUPERSET_SECRET_KEY=examplekeryde42characters
# Usuario admin inicial de Superset
SUPERSET_ADMIN_USER=example
# contraseña fuerte para admin de Superset
SUPERSET_ADMIN_PASSWORD=example02wqweq
# Email admin de Superset
SUPERSET_ADMIN_EMAIL=example12345@outlook.com
# Puerto en tu host por defecto 8088
SUPERSET_HOST_PORT=8088